# ==============================================================================
# Phase 46 — Environment Variables Specification
# Maldives Purchase Bills Entry & Tax Compliance Engine
# ==============================================================================

# Core Runtime Environment (development | staging | production | test)
NODE_ENV="development"

# Server Port (Required to be 3000 in container environment)
PORT=3000

# GEMINI_API_KEY: Required for Gemini AI document extraction & OCR.
# In AI Studio, inject via the Secrets panel.
GEMINI_API_KEY=""

# APP_URL: Publicly accessible URL for the application
APP_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL connection string with credentials & connection pooling
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crmaldives?schema=public"

# Database Connection Pool Configuration
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_TIMEOUT_MS=10000

# Structured Logging Level (debug | info | warn | error)
LOG_LEVEL="info"

# Session & Authentication Secret (Must be 32+ characters in production)
SESSION_SECRET="dev-insecure-session-secret-change-in-production"

# CORS Allowed Origin (Default is self or * in dev)
CORS_ORIGIN="*"

# Backup Storage Configuration
BACKUP_STORAGE_DIR="./data/backups"
BACKUP_RETENTION_DAYS=30

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
